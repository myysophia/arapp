# arapp Phase 2 本地环境示例（请复制为 AppEnvironment.local.env 并填写真实值）

# 运行模式：mock / staging / production
ARAPP_RUNTIME_MODE=mock

# Edge Functions API 基础地址（例如 https://your-project.functions.supabase.co）
ARAPP_EDGE_BASE_URL=

# 调试联调用的访问令牌（可选）
ARAPP_ACCESS_TOKEN=

# Supabase 配置（P2-04 开始会真正使用）
ARAPP_SUPABASE_URL=
ARAPP_SUPABASE_ANON_KEY=
ARAPP_SUPABASE_REDIRECT_SCHEME=
ARAPP_SUPABASE_REDIRECT_HOST=auth
ARAPP_SUPABASE_REDIRECT_PATH=/callback
